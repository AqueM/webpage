{% theme__border-square %}
{% block quote %}{% endblock %}
{% endtheme__border-square %}
{% heading "h2", "Summary" %}
<section>
{%- flex-columns -%}{%- flex-item %}
{% block summary %}{% endblock %}
{%- endflex-item -%}

{%- flex-aside -%}
{%- if portrait -%}{% gallery %}{% imageMine portrait %}{% endgallery %}{%- endif -%}

{% block list %}{% endblock %}
{%- endflex-aside -%}
{%- endflex-columns -%}
</section>

{% heading "h2", "Attributes" %}
<section>
<h3>Morals and values</h3>

{% block morals %}{% endblock %}
</section>
	
<section>
<h3>Appearance</h3>
	
{% block appearance %}{% endblock %}
</section>
	
<section>
<h3>Personality</h3>
	
{% block personality %}{% endblock %}
</section>
	
<section>
<h3>Relations</h3>
	
{% block relations %}{% endblock %}
</section>
	
{% heading "h2", "Religion" %}
<section>
<h3>Followers</h3>
{{followers}}
</section>
	
<section>
<h3>Temples and priests</h3>
	
{{temples}}
</section>
	
<section>
<h3>Portrayal</h3>

{% block portrayal %}{% endblock %}
</section>
	
<section>
<h3>Rituals</h3>

{% block rituals %}{% endblock %}
</section>
{%- if portrait -%}{% include "partials/_photoswipe-script.html" %}{%- endif -%}
