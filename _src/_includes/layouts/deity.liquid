{% theme__border-square %}
{% block quote %}{% endblock %}
{% endtheme__border-square %}
{% heading "h2", "Summary" %}
<section>
{%- flex-columns -%}{%- flex-item %}
{% block summary %}{% endblock %}
{% block list %}{% endblock %}
{%- endflex-item -%}

{%- if portrait -%}{%- flex-aside -%}
{% gallery %}{% imageMine portrait %}{% endgallery %}
{% endflex-aside %}{% endif %}
{%- endflex-columns -%}
</section>

{% heading "h2", "Attributes" %}
<section>
<h3>Morals and values</h3>

{% block morals %}{% endblock %}
</section>
	
<section>
<h3>Appearance</h3>
	
{% block appearance %}{% endblock %}
</section>
	
<section>
<h3>Personality</h3>
	
{% block personality %}{% endblock %}
</section>
	
<section>
<h3>Relations</h3>
	
{% block relations %}{% endblock %}
</section>
	
{% heading "h2", "Religion" %}
<section>
<h3>Followers</h3>
{% block followers %}{% endblock %}
</section>
	
<section>
<h3>Temples and priests</h3>
	
{% block temples %}{% endblock %}
</section>
	
<section>
<h3>Portrayal</h3>

{% block portrayal %}{% endblock %}
</section>
	
<section>
<h3>Rituals</h3>

{% block rituals %}{% endblock %}
</section>
{%- if bonusExists -%}
{% heading "h2", "Extras" %}<section>
{% block bonus %}{% endblock %}
</section>{% endif %}
{%- if portrait -%}{% include "partials/_photoswipe-script.html" %}{%- endif -%}
